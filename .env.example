# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어 Git 에 올라가지 않습니다. 키를 이 파일(.env.example)에 적지 마세요.

# ---------------------
# 로컬 Private LLM (Ollama 기본, vLLM 은 http://localhost:8000/v1)
# ---------------------
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma3:27b

# ---------------------
# AWS Credentials - AWS Bedrock 호출에 필요 (IAM 사용자 권한 최소화 권장)
#   권한 예시: docs/iam-policy-bedrock-gemma.json
#   비워 두면 ~/.aws/credentials (aws configure) 를 사용합니다.
# ---------------------
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 서울 리전 In-Region Gemma 3: google.gemma-3-4b-it / google.gemma-3-12b-it / google.gemma-3-27b-it
BEDROCK_MODEL_ID=google.gemma-3-12b-it
